# Основные настройки
APP_NAME=MMAS Service
DEBUG=false
LOG_JSON=false

# База данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://mmas:mmas@localhost:5433/mmas_db
DATABASE_ECHO=false

# JWT настройки
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Первый admin (создаётся автоматически, если staff_users пуста)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-production
